# ─────────────────────────────────────────────────────────
# Instagram Echo Bot – Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.

# A secret string YOU choose (any random string like "my_secret_token_123")
# Must match exactly what you enter in the Meta Webhook dashboard
VERIFY_TOKEN=your_webhook_verify_token_here

# Page Access Token from Meta Developer → your App → Instagram → Generate Token
# Use a long-lived token for production
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Your Instagram Business Account ID (numeric) 
# Find it: Meta Business Suite → Settings → Instagram Accounts OR Graph API Explorer
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Port the Express server listens on
PORT=3000
